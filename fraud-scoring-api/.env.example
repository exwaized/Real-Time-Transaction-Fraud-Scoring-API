# Copy to .env and fill in values — never commit .env to git

# API key callers must send in X-API-Key header
FRAUD_API_KEY=your-secret-key-here

# Set to "production" to enforce HTTPS redirect
ENV=development

# Optional: Slack webhook for drift alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
