# Copy to .env and fill in values — never commit .env to git

# API key callers must send in X-API-Key header.
# Single shared key (legacy; treated as client "default"):
FRAUD_API_KEY=your-secret-key-here
# Preferred: one key per caller, so limits and revocation are per client:
#   FRAUD_API_KEYS=payments=<key>,risk-ui=<key>
# Per-client rate limits in req/min (default 60):
#   FRAUD_RATE_LIMITS=payments=600,risk-ui=60
# Salt for hashing card IDs in logs and Redis keys. Set a long random value in prod:
CARD_HASH_SALT=

# Required in docker compose (compose refuses to start without it)
GRAFANA_ADMIN_PASSWORD=change-me

# Auth fails closed (503) if no API key is configured. For local non-docker dev
# only, uncomment to bypass auth:
# ALLOW_INSECURE_NO_AUTH=true

# Set to "production" to enforce HTTPS redirect
ENV=development

# Optional: Slack webhook for drift alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Shared backend for per-card velocity windows, behavioral profiles and the
# rate limiter (app/services/{velocity,rate_limit}.py) as well as the
# champion/challenger divergence log (app/services/divergence.py). REQUIRED
# whenever running more than one worker/replica; unset = per-process state. Leave unset to fall back to an in-process
# deque (fine for single-worker/local dev, but each worker gets its own
# feed). Set this when running --workers > 1 or multiple replicas so the
# divergence feed at GET /challenger/divergence is one shared view across
# all of them, e.g. redis://redis:6379/0 (docker compose) or
# redis://localhost:6379/0 (local Redis).
REDIS_URL=

# Optional: borderline-score adjudicator (app/services/adjudicator.py).
# docker-compose.yml already points JEV_ENDPOINT at the semif-sidecar service's
# /decide route (a small CPU-only Laya decision model, semif_sidecar/main.py)
# by default. Leave JEV_API_KEY unset to disable — scoring falls back to the
# raw threshold decision. Set it to enable review; it must match the sidecar's
# own SEMIF_API_KEY (docker-compose.yml wires both to this same value).
JEV_ENDPOINT=
JEV_API_KEY=
# How close to the model threshold counts as "ambiguous enough to review"
REVIEW_MARGIN=0.05
