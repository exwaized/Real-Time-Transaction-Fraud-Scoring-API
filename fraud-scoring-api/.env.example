# Copy to .env and fill in values — never commit .env to git

# API key callers must send in X-API-Key header
FRAUD_API_KEY=your-secret-key-here

# Set to "production" to enforce HTTPS redirect
ENV=development

# Optional: Slack webhook for drift alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Optional: borderline-score adjudicator (app/services/adjudicator.py).
# Leave unset to disable — scoring falls back to the raw threshold decision.
# Point JEV_ENDPOINT at the semif_sidecar service's /decide route, e.g.
# http://semif-sidecar:8600/decide (docker compose --profile semif up).
# JEV_API_KEY must match that sidecar's own SEMIF_API_KEY.
JEV_ENDPOINT=
JEV_API_KEY=
# How close to the model threshold counts as "ambiguous enough to review"
REVIEW_MARGIN=0.05
